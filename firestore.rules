rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() {
      return request.auth != null;
    }
    function registrado() {
      return conSesion() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function esAdmin() {
      return registrado() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    // Perfiles de técnicos y administradores
    match /usuarios/{uid} {
      allow read: if conSesion() && (request.auth.uid == uid || esAdmin());
      allow write: if esAdmin();
    }

    // Versión vigente del formato
    match /config/{doc} {
      allow read: if registrado();
      allow write: if esAdmin();
    }

    // Historial de versiones del formato (no se borran nunca)
    match /formatos/{version} {
      allow read: if registrado();
      allow create: if esAdmin();
      allow update, delete: if false;
    }

    // Informes de servicio técnico
    match /informes/{id} {
      allow create: if registrado() && request.resource.data.tecnicoUid == request.auth.uid;
      allow read: if esAdmin() || (registrado() && resource.data.tecnicoUid == request.auth.uid);
      // Un informe finalizado no se modifica. El técnico solo puede:
      //  - seguir editando un informe que dejó PENDIENTE, sin cambiarle número ni dueño;
      //  - ponerle el número consecutivo cuando todavía no lo tiene.
      allow update: if esAdmin()
        || (registrado()
          && resource.data.tecnicoUid == request.auth.uid
          && resource.data.get("estado", "") == "pendiente"
          && request.resource.data.tecnicoUid == resource.data.tecnicoUid
          && request.resource.data.numero == resource.data.numero)
        || (registrado()
          && resource.data.tecnicoUid == request.auth.uid
          && resource.data.numero == ""
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["numero"]));
      allow delete: if esAdmin();

      // Fotos del informe (antes y después)
      match /fotos/{fotoId} {
        allow create: if registrado() && request.resource.data.tecnicoUid == request.auth.uid;
        allow read: if esAdmin() || (registrado() && resource.data.tecnicoUid == request.auth.uid);
        // Mientras el informe está pendiente, el técnico puede cambiar o quitar sus fotos
        allow update, delete: if esAdmin() || (registrado()
          && resource.data.tecnicoUid == request.auth.uid
          && get(/databases/$(database)/documents/informes/$(id)).data.get("estado", "") == "pendiente");
      }
    }

    // Consecutivo único de informes y total de informes de cada técnico
    //   contadores/informes       { ultimo }          -> solo puede subir de uno en uno
    //   contadores/tecnico_{uid}  { total, meses }    -> lo lleva cada técnico
    match /contadores/{id} {
      allow read: if registrado();
      allow create: if esAdmin() || (registrado() && id == "tecnico_" + request.auth.uid);
      allow update: if esAdmin()
        || (registrado() && id == "tecnico_" + request.auth.uid)
        || (registrado() && id == "informes" && request.resource.data.ultimo == resource.data.ultimo + 1);
      allow delete: if esAdmin();
    }

    // Solicitudes de permiso laboral
    match /permisos/{id} {
      allow create: if registrado()
        && request.resource.data.tecnicoUid == request.auth.uid
        && request.resource.data.estado == "solicitado";
      allow read: if esAdmin() || (registrado() && resource.data.tecnicoUid == request.auth.uid);
      // Solo el administrador responde. El trabajador puede retirar la suya mientras no se haya respondido.
      allow update: if esAdmin();
      allow delete: if esAdmin() || (registrado()
        && resource.data.tecnicoUid == request.auth.uid
        && resource.data.estado == "solicitado");
    }

    // Incapacidades con su documento escaneado
    match /incapacidades/{id} {
      allow create: if registrado()
        && request.resource.data.tecnicoUid == request.auth.uid
        && request.resource.data.estado == "enviada";
      allow read: if esAdmin() || (registrado() && resource.data.tecnicoUid == request.auth.uid);
      // Solo el administrador da el aval o la rechaza. La persona puede retirarla mientras no se haya revisado.
      allow update: if esAdmin();
      allow delete: if esAdmin() || (registrado()
        && resource.data.tecnicoUid == request.auth.uid
        && resource.data.estado == "enviada");

      // Documento escaneado, partido en trozos de menos de 1 MB
      match /archivos/{archivoId} {
        allow create: if registrado()
          && request.resource.data.tecnicoUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/incapacidades/$(id)).data.tecnicoUid == request.auth.uid;
        allow read: if esAdmin() || (registrado() && resource.data.tecnicoUid == request.auth.uid);
        allow update: if false;
        allow delete: if esAdmin() || (registrado()
          && resource.data.tecnicoUid == request.auth.uid
          && get(/databases/$(database)/documents/incapacidades/$(id)).data.estado == "enviada");
      }
    }

    // Novedades del día por persona (incapacidad, permiso, vacaciones…)
    match /novedades/{id} {
      allow read: if esAdmin() || (registrado() && resource.data.tecnicoUid == request.auth.uid);
      allow write: if esAdmin();
    }

    // Sitios con código QR para el registro de horario
    match /sitios/{id} {
      allow read: if registrado();
      allow write: if esAdmin();
    }

    // Marcaciones de entrada y salida
    match /marcaciones/{id} {
      // Cada persona crea sus marcaciones; el administrador puede agregar las que falten.
      allow create: if esAdmin() || (registrado() && request.resource.data.tecnicoUid == request.auth.uid);
      allow read: if esAdmin() || (registrado() && resource.data.tecnicoUid == request.auth.uid);
      // Una marcación no se modifica desde la app. Solo el administrador puede corregirla o borrarla.
      allow update, delete: if esAdmin();
    }
  }
}
